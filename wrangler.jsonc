{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northgo-w4",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-15",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "northgo-w4",
      "database_id": "c9aaddf2-0968-4ae0-860d-94bae38a5378",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "northgo-w4-media"
    }
  ]
}
